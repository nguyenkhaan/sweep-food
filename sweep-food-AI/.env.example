# Sweep Food AI environment variables template
# Copy this file to .env and fill in the values

# Groq API Key for whisper-large-v3-turbo ASR
GROQ_API_KEY=your_groq_api_key_here

# OCR provider for receipts and food labels: "openai" (default) or "groq" (fallback).
# With "openai" and no OPENAI_API_KEY, the app falls back to Groq automatically.
OCR_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
# Optional overrides (defaults chosen from the 16/10/2026 OCR comparison)
OPENAI_OCR_MODEL=gpt-6.1-sol
OPENAI_OCR_REASONING=medium
