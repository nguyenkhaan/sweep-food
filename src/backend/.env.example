ENV=dev
DATABASE_URL=postgresql+asyncpg://username:password@host:5432/database
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-of-at-least-32-bytes
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret-of-at-least-32-bytes
JWT_ALGORITHM=HS256
DEFAULT_OTP=123456
REDIS_URL=redis://redis:6379/0
OTP_CHALLENGE_TTL_SECONDS=300
OTP_GRANT_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_DESTINATION_REQUEST_LIMIT=5
OTP_IP_REQUEST_LIMIT=20
OTP_REQUEST_WINDOW_SECONDS=3600
OTP_MAX_VERIFICATION_ATTEMPTS=5
OTP_FAILED_ATTEMPT_COOLDOWN_SECONDS=900
WIREMOCK_URL=http://wiremock:8080
SMS_PROVIDER=wiremock
SMS_DELIVERY_TIMEOUT_SECONDS=2
# Used for a direct local backend run; Docker Compose overrides this to `mailpit`.
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=1025
EMAIL_FROM=noreply@sweep-food.local
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=30
#FIREBASE
FCM_PROVIDER=wiremock
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_FILE=./firebase-service-account.json
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
FCM_TOKEN_ENCRYPTION_KEY=
FCM_DELIVERY_TIMEOUT_SECONDS=5
NOTIFICATION_DEFAULT_WARNING_DAYS=3
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_SCAN_HOUR_LOCAL=8
# Extraction limits
EXTRACTION_MAX_IMAGE_SIZE=5242880
EXTRACTION_MAX_AUDIO_SIZE=10485760
EXTRACTION_MAX_AUDIO_DURATION=60
EXTRACTION_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
EXTRACTION_ALLOWED_AUDIO_TYPES=audio/mpeg,audio/wav,audio/ogg
EXTRACTION_PROVIDER_TIMEOUT=15
